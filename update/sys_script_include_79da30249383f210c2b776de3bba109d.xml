        <name>GetEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetEmailAddress = Class.create();
// Estendiamo la classe globale per abilitare le funzioni Ajax
GetEmailAddress.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    // Funzione personalizzata
    getEmail: function() {
        // 1. Recupero il parametro inviato dal Client (l'ID dell'utente)
        var userId = this.getParameter('sysparm_userID');
        
        // 2. Cerco nel database utenti
        var userRecord = new GlideRecord("sys_user");
        userRecord.get(userId);
        
        // 3. Restituisco l'email (convertita in stringa)
        return userRecord.email + '';
    },

    type: 'GetEmailAddress'
});]]></script>
